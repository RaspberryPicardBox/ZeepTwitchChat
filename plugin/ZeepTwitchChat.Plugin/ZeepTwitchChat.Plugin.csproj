<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ZeepTwitchChat.Plugin — mirrors your own Twitch chat into Zeepkist's lobby chat.

    TargetFramework (net472), the BepInEx/Unity/Zeepkist reference HintPaths and the
    game-path properties all live in the repository-root Directory.Build.props.

    The output DLL name is fixed to ZeepTwitchChat.dll so that tools/deploy-plugin.sh
    and the mod.io package layout find it at:
      plugin/ZeepTwitchChat.Plugin/bin/<Configuration>/net472/ZeepTwitchChat.dll
  -->

  <PropertyGroup>
    <AssemblyName>ZeepTwitchChat</AssemblyName>
    <RootNamespace>ZeepTwitchChat</RootNamespace>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>ZeepTwitchChat</Product>
    <Description>Shows your own Twitch chat in Zeepkist's in-game chat, colour-coded and labelled.</Description>
    <Copyright>MIT</Copyright>
    <!-- Keep the output to our own DLL: BepInEx, Unity and game assemblies come from the install. -->
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies so net472 compiles on Linux with the .NET SDK. Build-only. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
